# =============================================================================
# Aurora Local Development Root Environment Variables
# =============================================================================

# PostgreSQL Credentials
POSTGRES_USER=aurora_admin
POSTGRES_PASSWORD=aurora_secure_password_2026!

# RabbitMQ Credentials
RABBITMQ_USER=aurora_admin
RABBITMQ_PASSWORD=aurora_secure_password_2026!

# BFF Shared Secrets
BFF_JWT_SECRET=insecure-dev-secret-key-at-least-32-bytes-long!

# Stalwart Dev Admin Key
STALWART_ADMIN_API_KEY=local_stalwart_dev_key

# Optional Developer AI API Keys (Optional in local development)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GITHUB_TOKEN=
