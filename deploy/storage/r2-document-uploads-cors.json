{
  "rules": [
    {
      "allowed": {
        "origins": [
          "http://localhost:3000",
          "https://humanak.cyou",
          "https://www.humanak.cyou",
          "https://admin.humanak.cyou",
          "https://system.humanak.cyou"
        ],
        "methods": [
          "PUT"
        ],
        "headers": [
          "Content-Type",
          "x-amz-meta-content-sha256"
        ],
        "exposeHeaders": [
          "ETag"
        ],
        "maxAgeSeconds": 600
      }
    }
  ]
}
