# =============================================================================
# Subscription 1: CORE Environment Variables
# =============================================================================

# 1. Subscription & Resource Group
subscription_id     = "<CORE_SUBSCRIPTION_ID>"
resource_group_name = "rg-aurora-core-demo"
location            = "southeastasia"
environment         = "demo"

# 2. Networking
vnet_name          = "vnet-aurora-core"
vnet_cidr          = "10.10.0.0/16"
aks_subnet_cidr    = "10.10.0.0/20"
appgw_subnet_cidr  = "10.10.16.0/24"
enable_nat_gateway = false
availability_zones = ["1"]

# 3. Compute & Storage
acr_name           = "acrauroracoredemo"
cluster_name       = "aks-core-demo"
dns_prefix         = "aurora-core"
node_count         = 2
node_vm_size       = "Standard_D2s_v5"
kubernetes_version = "1.30.3"
appgw_name         = "appgw-aurora-core-demo"

# 4. Cross-Subscription References (Obtain from Shared and AI outputs)
shared_vnet_id      = "/subscriptions/<SHARED_SUBSCRIPTION_ID>/resourceGroups/rg-aurora-shared-demo/providers/Microsoft.Network/virtualNetworks/vnet-aurora-shared"
ai_vnet_id          = "/subscriptions/<AI_SUBSCRIPTION_ID>/resourceGroups/rg-aurora-ai-demo/providers/Microsoft.Network/virtualNetworks/vnet-aurora-ai"
shared_key_vault_id = "/subscriptions/<SHARED_SUBSCRIPTION_ID>/resourceGroups/rg-aurora-shared-demo/providers/Microsoft.KeyVault/vaults/kv-aurora-shared-demo"
