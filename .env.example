# =============================================================================
# Aurora Server — Root Environment Variables Example
# =============================================================================
# Sao chép file này thành `.env` ở root và điền giá trị thực.
# KHÔNG commit file `.env` vào git (đã được thêm vào .gitignore).
# =============================================================================


# =============================================================================
# SECTION 1: SHARED INFRASTRUCTURE (Dùng chung cho các service khi chạy local / dev)
# =============================================================================

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
# Kiến trúc Database-per-Service: Cùng 1 PostgreSQL host nhưng mỗi service 1 DB riêng.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=changeme

# ── Redis / Valkey ─────────────────────────────────────────────────────────────
# Host bao gồm cả port (ví dụ: localhost:6379) hoặc Azure Managed Redis / Redis Cloud
REDIS_HOST=localhost:6379
REDIS_PASSWORD=
# Để trống REDIS_PASSWORD nếu Redis local không cài đặt password

# ── RabbitMQ ───────────────────────────────────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/


# =============================================================================
# SECTION 2: AWS CREDENTIALS & COGNITO AUTHENTICATION
# =============================================================================

# ── AWS Credentials (IAM User cho Local Dev / SDK calls) ───────────────────────
# Cần cấp quyền AmazonCognitoPowerUser hoặc AmazonCognitoIdpFullAccess cho IAM User này
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY

# ── AWS Cognito Root / System User Pool (Dùng cho IamTenant & BFF) ────────────
# User Pool ID root/mặc định (ví dụ: ap-southeast-1_XXXXXXXXX)
COGNITO_USER_POOL_ID=ap-southeast-1_XXXXXXXXX
# App Client ID (User Pool App Client - không bật Generate Secret hoặc có secret tương ứng)
COGNITO_APP_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
COGNITO_APP_CLIENT_SECRET=
# Domain prefix hoặc full domain của Hosted UI (nếu dùng OIDC Web Flow qua BFF)
# Ví dụ: "aurora-auth" -> https://aurora-auth.auth.ap-southeast-1.amazoncognito.com
COGNITO_DOMAIN=aurora-auth-dev


# =============================================================================
# SECTION 3: IAM TENANT SERVICE (.NET 10 gRPC / Port 5001)
# =============================================================================

IAMTENANT_DB=Host=${POSTGRES_HOST};Port=${POSTGRES_PORT};Database=iam_tenant_db;Username=${POSTGRES_USERNAME};Password=${POSTGRES_PASSWORD}
IAMTENANT_GRPC_PORT=5001

# Map trực tiếp vào .NET Configuration:
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=iam_tenant_db;Username=postgres;Password=changeme
Cognito__UserPoolId=ap-southeast-1_XXXXXXXXX
Cognito__ClientId=XXXXXXXXXXXXXXXXXXXXXXXXXX
Cognito__ClientSecret=
Redis__Host=localhost:6379


# =============================================================================
# SECTION 4: ROUTE PLANNING AGENT & OPTIMIZATION (.NET gRPC / Port 5002)
# =============================================================================

ROUTEPLANNING_DB=Host=${POSTGRES_HOST};Port=${POSTGRES_PORT};Database=route_planning_db;Username=${POSTGRES_USERNAME};Password=${POSTGRES_PASSWORD}
ROUTEPLANNING_GRPC_PORT=5002

# ── Route Optimization: OSRM (MLD routing engine) + VROOM (VRP solver) ────────
Optimization__OsrmUrl=http://localhost:5010
Optimization__VroomUrl=http://localhost:3000
Optimization__TimeoutSeconds=30

# Azure Blob Storage Downloader Config (OSRM Map Datasets)
OSRM_STORAGE_PROVIDER=AZURE_BLOB
AZURE_STORAGE_ACCOUNT_NAME=stauroradatademo
AZURE_STORAGE_CONTAINER=osrm
AZURE_OSRM_BLOB_PREFIX=


# =============================================================================
# SECTION 5: MAIL PLATFORM (Unified on AKS aks-core / Local Integration)
# =============================================================================
# MailService (.NET) + Stalwart MTA + ClamAV + SpamAssassin đã quy hoạch chung về AKS

# ── MailService Database (Database-per-Service) ─────────────────────────────────
MAIL_SERVICE_DB=Host=${POSTGRES_HOST};Port=${POSTGRES_PORT};Database=mail_service_db;Username=${POSTGRES_USERNAME};Password=${POSTGRES_PASSWORD}

# ── Stalwart Mail Server ──────────────────────────────────────────────────────
STALWART_ADMIN_URL=http://localhost:8080
STALWART_ADMIN_TOKEN=local_stalwart_dev_key
STALWART_SMTP_HOST=localhost
STALWART_SMTP_PORT=25

# ── Outbound SMTP Relay (Port 587 - AWS SES / SendGrid cho Azure/Prod) ────────
STALWART_RELAY_HOST=email-smtp.ap-southeast-1.amazonaws.com
STALWART_RELAY_PORT=587
STALWART_RELAY_USERNAME=
STALWART_RELAY_PASSWORD=

# ── Security Pipeline Antivirus & Antispam ────────────────────────────────────
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
SPAMASSASSIN_HOST=localhost
SPAMASSASSIN_PORT=783


# =============================================================================
# SECTION 6: OTHER CORE & AI MICROSERVICES (Database & Ports)
# =============================================================================

SHIPMENT_WORKFLOW_DB=Host=${POSTGRES_HOST};Port=${POSTGRES_PORT};Database=shipment_workflow_db;Username=${POSTGRES_USERNAME};Password=${POSTGRES_PASSWORD}
GPS_TRACKING_DB=Host=${POSTGRES_HOST};Port=${POSTGRES_PORT};Database=gps_tracking_db;Username=${POSTGRES_USERNAME};Password=${POSTGRES_PASSWORD}
BILLING_DB=Host=${POSTGRES_HOST};Port=${POSTGRES_PORT};Database=billing_db;Username=${POSTGRES_USERNAME};Password=${POSTGRES_PASSWORD}
FINANCIAL_DB=Host=${POSTGRES_HOST};Port=${POSTGRES_PORT};Database=financial_db;Username=${POSTGRES_USERNAME};Password=${POSTGRES_PASSWORD}
NOTIFICATION_DB=Host=${POSTGRES_HOST};Port=${POSTGRES_PORT};Database=notification_db;Username=${POSTGRES_USERNAME};Password=${POSTGRES_PASSWORD}
AUDIT_DB=Host=${POSTGRES_HOST};Port=${POSTGRES_PORT};Database=audit_service_db;Username=${POSTGRES_USERNAME};Password=${POSTGRES_PASSWORD}
AI_GOVERNANCE_DB=Host=${POSTGRES_HOST};Port=${POSTGRES_PORT};Database=ai_governance_db;Username=${POSTGRES_USERNAME};Password=${POSTGRES_PASSWORD}
DOCUMENT_OCR_DB=Host=${POSTGRES_HOST};Port=${POSTGRES_PORT};Database=document_ocr_db;Username=${POSTGRES_USERNAME};Password=${POSTGRES_PASSWORD}

# ── External AI Provider Keys (Optional cho Local Dev) ─────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=


# =============================================================================
# SECTION 7: OBSERVABILITY & LOGGING
# =============================================================================

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=aurora-server
LOG_LEVEL=Information
# LOG_SEQ_URL=http://localhost:5341


# =============================================================================
# SECTION 8: CORS & FRONTEND CLIENTS
# =============================================================================

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://aurora.yourdomain.vn
