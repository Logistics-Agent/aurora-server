generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model BaseFreightRate {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  originPort      String   @map("origin_port")
  destinationPort String   @map("destination_port")
  cargoType       String   @default("GENERAL") @map("cargo_type")
  ratePerKg       Float    @map("rate_per_kg")
  ratePerCbm      Float    @map("rate_per_cbm")
  flatFee         Float    @map("flat_fee")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([tenantId, originPort, destinationPort, cargoType])
  @@map("base_freight_rates")
}

model CustomsDutyRate {
  id                 String   @id @default(uuid())
  originCountry      String   @map("origin_country")
  destinationCountry String   @map("destination_country")
  hsCode             String   @map("hs_code")
  dutyRatePercentage Float    @map("duty_rate_percentage")
  description        String?  @map("description")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@unique([originCountry, destinationCountry, hsCode])
  @@map("customs_duty_rates")
}
