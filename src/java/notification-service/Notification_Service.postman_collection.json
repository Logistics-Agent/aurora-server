							"});",
							"pm.test(\"Notification created and saved notificationId\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.id).to.be.a('string');",
							"    pm.collectionVariables.set(\"notificationId\", jsonData.id);",
							"});"
						],
