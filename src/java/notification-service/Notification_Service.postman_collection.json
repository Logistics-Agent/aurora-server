					"raw": "{\n  \"tenantId\": \"tenant-aurora-01\",\n  \"userId\": \"user-123\",\n  \"title\": \"Đơn hàng mới #SHIP-{{$randomInt}}\",\n  \"body\": \"Giao hàng cho khách {{$randomFullName}} tại {{$randomCompanyName}}\",\n  \"actionUrl\": \"https://aurora.logistics.com/shipments/{{$randomInt}}\",\n  \"priority\": \"WARNING\"\n}",
