{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "DocumentProcessing": {
    "MaxDocumentBytes": 10485760,
    "MaxPages": 50,
    "ReviewConfidenceThreshold": 0.85,
    "Provider": "Deterministic",
    "SupportedMimeTypes": [
      "application/pdf",
      "image/jpeg",
      "image/png",
      "image/tiff",
      "text/markdown"
    ],
    "SupportedExtensions": [
      ".pdf",
      ".jpg",
      ".jpeg",
      ".png",
      ".tif",
      ".tiff",
      ".md"
    ]
  },
  "DocumentUploads": {
    "SessionExpiry": "00:15:00",
    "CleanupInterval": "00:01:00"
  },
  "Storage": {
    "InputProvider": "FileSystem",
    "InputPath": "storage/inputs",
    "InputBridge": {
      "PublicBaseUrl": "http://localhost:5000/",
      "AllowedOrigins": "http://localhost:3000"
    }
  },
  "DocumentOcrWorker": {
    "BatchSize": 10,
    "MaxAttempts": 3,
    "PollingInterval": "00:00:02",
    "LeaseDuration": "00:02:00",
    "HeartbeatInterval": "00:00:30",
    "BaseRetryDelay": "00:00:10",
    "MaxRetryDelay": "00:05:00",
    "MaxRetryJitter": "00:00:05"
  },
  "DocumentOcrOutbox": {
    "BatchSize": 50,
    "MaxRetries": 5,
    "PollingInterval": "00:00:02"
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  }
}
