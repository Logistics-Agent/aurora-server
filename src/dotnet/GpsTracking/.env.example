# Template only. .NET does not load .env files automatically.
# Local: export the variables before `dotnet run`, or load with `set -a; source .env; set +a`.
# Azure: create these as Container App environment variables/secrets.

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:6002

# PostgreSQL connection for GpsTracking.
ConnectionStrings__DefaultConnection="Host=localhost;Port=5435;Database=aurora_gps_tracking;Username=postgres;Password=postgres"

# Shared infrastructure.
Redis__Host=localhost:6379
Redis__Password=
RabbitMQ__Host=localhost
RabbitMQ__Username=aurora
RabbitMQ__Password=aurora_dev

# Monitoring thresholds. Short values are useful for local testing only.
GpsMonitoring__StationarySpeedKph=1
GpsMonitoring__AbnormalStopDuration=00:00:20
GpsMonitoring__SignalLossThreshold=00:00:20
GpsMonitoring__SignalLossScanInterval=00:00:05
GpsMonitoring__SignalLossBatchSize=100

GpsOutbox__BatchSize=50
GpsOutbox__MaxRetries=5
GpsOutbox__PollingInterval=00:00:02

# Local-only identity. Keep disabled/omitted in Production.
DevelopmentIdentity__Enabled=true
DevelopmentIdentity__UserId=01910000-0000-7000-8000-000000000001
DevelopmentIdentity__TenantId=01920000-0000-7000-8000-000000000001
DevelopmentIdentity__PermissionVersion=1
DevelopmentIdentity__Role=STAFF
