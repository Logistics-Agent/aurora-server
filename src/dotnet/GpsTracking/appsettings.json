{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "GpsMonitoring": {
    "StationarySpeedKph": 1,
    "AbnormalStopDuration": "00:15:00",
    "SignalLossThreshold": "00:05:00",
    "SignalLossScanInterval": "00:01:00",
    "SignalLossBatchSize": 100
  },
  "GpsOutbox": {
    "BatchSize": 50,
    "MaxRetries": 5,
    "PollingInterval": "00:00:02"
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  }
}
