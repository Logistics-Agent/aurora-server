{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:7101"
      }
    }
  },
  "Auth": {
    "Jwt": {
      "Authority": "",
      "Audience": "",
      "RoleClaimType": "cognito:groups"
    },
    "CookieSecure": true
  },
  "Redis": {
    "ConnectionString": "redis:6379"
  },
  "Grpc": {
    "IamTenant": {
      "Url": "http://iam-tenant:5294"
    },
    "AuditService": {
      "Url": "http://audit-service:9086"
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "RateLimit": {
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "QueueLimit": 50
  },
  "OpenTelemetry": {
    "ServiceName": "system-bff"
  }
}
