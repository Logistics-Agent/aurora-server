{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:8080"
      }
    }
  },
  "Auth": {
    "Cognito": {
      "Region": "ap-southeast-1",
      "UserPoolId": "",
      "ClientId": "",
      "ClientSecret": "",
      "Domain": "aurora-platform-demo",
      "AppDomain": "https://system.humanak.cyou"
    },
    "Cookie": {
      "Secure": true,
      "Domain": ".humanak.cyou",
      "TokenRefreshBufferMinutes": 5,
      "SessionTimeoutMinutes": 480,
      "SameSite": "None"
    },
    "Jwt": {
      "Authority": "",
      "Audience": "",
      "RoleClaimType": "cognito:groups"
    }
  },
  "Redis": {
    "ConnectionString": "redis:6379"
  },
  "Grpc": {
    "IamTenant": {
      "Url": "http://iam-tenant:5294"
    },
    "AuditService": {
      "Url": "http://audit-service:9086"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "RateLimit": {
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "QueueLimit": 50
  },
  "OpenTelemetry": {
    "ServiceName": "system-bff"
  }
}