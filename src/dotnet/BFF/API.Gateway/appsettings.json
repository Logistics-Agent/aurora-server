{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:8080"
      }
    }
  },
  "ReverseProxy": {
    "Routes": {
      "system-route": {
        "ClusterId": "system-cluster",
        "Match": {
          "Path": "/api/v1/system/{**catch-all}"
        },
        "Transforms": [
          { "RequestHeaderRemove": "x-user-id" },
          { "RequestHeaderRemove": "x-tenant-id" },
          { "RequestHeaderRemove": "x-role" },
          { "RequestHeaderRemove": "x-permission-version" },
          { "RequestHeaderRemove": "x-access-token" },
          { "RequestHeaderRemove": "x-trace-id" }
        ]
      },
      "admin-route": {
        "ClusterId": "admin-cluster",
        "Match": {
          "Path": "/api/v1/admin/{**catch-all}"
        },
        "Transforms": [
          { "RequestHeaderRemove": "x-user-id" },
          { "RequestHeaderRemove": "x-tenant-id" },
          { "RequestHeaderRemove": "x-role" },
          { "RequestHeaderRemove": "x-permission-version" },
          { "RequestHeaderRemove": "x-access-token" },
          { "RequestHeaderRemove": "x-trace-id" }
        ]
      },
      "staff-route": {
        "ClusterId": "staff-cluster",
        "Match": {
          "Path": "/api/v1/{**catch-all}"
        },
        "Transforms": [
          { "RequestHeaderRemove": "x-user-id" },
          { "RequestHeaderRemove": "x-tenant-id" },
          { "RequestHeaderRemove": "x-role" },
          { "RequestHeaderRemove": "x-permission-version" },
          { "RequestHeaderRemove": "x-access-token" },
          { "RequestHeaderRemove": "x-trace-id" }
        ]
      }
    },
    "Clusters": {
      "system-cluster": {
        "Destinations": {
          "system-bff": {
            "Address": "http://system-bff:8080"
          }
        }
      },
      "admin-cluster": {
        "Destinations": {
          "admin-bff": {
            "Address": "http://admin-bff:8080"
          }
        }
      },
      "staff-cluster": {
        "Destinations": {
          "staff-bff": {
            "Address": "http://staff-bff:8080"
          }
        }
      }
    }
  }
}
