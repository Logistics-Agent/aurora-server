{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://localhost:7100"
      }
    }
  },
  "ReverseProxy": {
    "Routes": {
      "system-route": {
        "ClusterId": "system-cluster",
        "Match": {
          "Path": "/api/v1/system/{**catch-all}"
        },
        "Transforms": [
          { "RequestHeaderRemove": "x-user-id" },
          { "RequestHeaderRemove": "x-tenant-id" },
          { "RequestHeaderRemove": "x-role-ids" },
          { "RequestHeaderRemove": "x-permission-version" },
          { "RequestHeaderRemove": "x-access-token" },
          { "RequestHeaderRemove": "x-trace-id" }
        ]
      },
      "admin-route": {
        "ClusterId": "admin-cluster",
        "Match": {
          "Path": "/api/v1/admin/{**catch-all}"
        },
        "Transforms": [
          { "RequestHeaderRemove": "x-user-id" },
          { "RequestHeaderRemove": "x-tenant-id" },
          { "RequestHeaderRemove": "x-role-ids" },
          { "RequestHeaderRemove": "x-permission-version" },
          { "RequestHeaderRemove": "x-access-token" },
          { "RequestHeaderRemove": "x-trace-id" }
        ]
      },
      "staff-route": {
        "ClusterId": "staff-cluster",
        "Match": {
          "Path": "/api/v1/{**catch-all}"
        },
        "Transforms": [
          { "RequestHeaderRemove": "x-user-id" },
          { "RequestHeaderRemove": "x-tenant-id" },
          { "RequestHeaderRemove": "x-role-ids" },
          { "RequestHeaderRemove": "x-permission-version" },
          { "RequestHeaderRemove": "x-access-token" },
          { "RequestHeaderRemove": "x-trace-id" }
        ]
      }
    },
    "Clusters": {
      "system-cluster": {
        "Destinations": {
          "system-bff": {
            "Address": "https://localhost:7101"
          }
        }
      },
      "admin-cluster": {
        "Destinations": {
          "admin-bff": {
            "Address": "https://localhost:7102"
          }
        }
      },
      "staff-cluster": {
        "Destinations": {
          "staff-bff": {
            "Address": "https://localhost:7103"
          }
        }
      }
    }
  }
}
