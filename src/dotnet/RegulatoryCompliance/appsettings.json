{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RegulatoryCompliance": {
    "EmbeddingProvider": "Deterministic",
    "EmbeddingModel": "deterministic-local",
    "EmbeddingModelVersion": "1",
    "EmbeddingDimension": 64,
    "EmbeddingBatchSize": 64,
    "EmbeddingPollingInterval": "00:00:02",
    "ProviderTimeout": "00:00:30",
    "RetrievalMaximumTopK": 20,
    "RetrievalMinimumScore": 0.2,
    "OutboxBatchSize": 50,
    "OutboxMaxRetries": 5,
    "OutboxPollingInterval": "00:00:02"
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  }
}
