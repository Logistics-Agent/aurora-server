# ==============================================================================
# Aurora Mail Platform — Production Environment Configuration (.env.prod)
# Gate 6B: DEPLOYMENT-READY
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to /opt/aurora/mail/.env.prod on the Mini PC.
# 2. Populate all values securely.
# 3. Restrict permissions: chmod 600 /opt/aurora/mail/.env.prod
# 4. NEVER commit real production .env.prod to Git!
# ==============================================================================

# ── Container Image Versions / Digests ────────────────────────────────────────
MAIL_SERVICE_IMAGE=ghcr.io/aurora/mail-service:1.0.0

# ── Primary Domain & Hostname ────────────────────────────────────────────────
MAIL_DOMAIN=aurora.vn
MAIL_HOSTNAME=mail.aurora.vn

# ── External Managed Neon PostgreSQL (SSL Required) ──────────────────────────
# Format: Host=ep-xxx.ap-southeast-1.aws.neon.tech;Port=5432;Database=aurora_mail_service;Username=aurora_admin;Password=xxx;SslMode=Require;TrustServerCertificate=true
NEON_DATABASE_URL=Host=ep-sample-production.ap-southeast-1.aws.neon.tech;Port=5432;Database=aurora_mail_service;Username=aurora_admin;Password=REPLACE_WITH_STRONG_NEON_PASSWORD;SslMode=Require;TrustServerCertificate=true

# ── External Aurora AI Governance Service (gRPC) ─────────────────────────────
# Endpoint of the centralized AI Governance gRPC service (on AKS or VPC)
AI_GOVERNANCE_GRPC_ENDPOINT=http://ai-governance.internal:5005

# ── Stalwart Mail Server Configuration ───────────────────────────────────────
STALWART_ADMIN_TOKEN=REPLACE_WITH_GENERATED_SECURE_RANDOM_STALWART_ADMIN_TOKEN

# ── RabbitMQ Credentials (Local Stack) ───────────────────────────────────────
RABBITMQ_USER=aurora_mail_app
RABBITMQ_PASSWORD=REPLACE_WITH_STRONG_RABBITMQ_PASSWORD
RABBITMQ_VHOST=mail

# ── Cloudflare R2 Raw EML & Attachment Storage ───────────────────────────────
CF_ACCOUNT_ID=REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID
R2_BUCKET_NAME=aurora-mail-production
R2_ACCESS_KEY=REPLACE_WITH_R2_ACCESS_KEY_ID
R2_SECRET_KEY=REPLACE_WITH_R2_SECRET_ACCESS_KEY

# ── Centralized Observability (OTLP to AKS OpenTelemetry Collector) ───────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.aurora.internal:4317
