# Template only. .NET does not load .env files automatically.
# Local: export the variables before `dotnet run`, or load with `set -a; source .env; set +a`.
# Azure: create these as Container App environment variables/secrets.

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:6001

# PostgreSQL connection for Notification.
ConnectionStrings__NotificationDatabase="Host=localhost;Port=5434;Database=aurora_notification;Username=postgres;Password=postgres"

# Shared infrastructure.
Redis__Host=localhost:6379
Redis__Password=
RabbitMQ__Host=localhost
RabbitMQ__Username=aurora
RabbitMQ__Password=aurora_dev

# Notification gRPC service-to-service authentication.
ServiceAuth__AllowedServiceId=staff-bff
ServiceAuth__ApiKey=replace-with-a-long-random-secret

# FCM delivery. Keep false until the Firebase Admin JSON is mounted.
Firebase__Enabled=false
Firebase__CredentialsPath=src\dotnet\Notification\aurora-notification-admin.json

# Local-only identity. Keep disabled/omitted in Production.
DevelopmentIdentity__Enabled=true
DevelopmentIdentity__UserId=01910000-0000-7000-8000-000000000001
DevelopmentIdentity__TenantId=01920000-0000-7000-8000-000000000001
DevelopmentIdentity__PermissionVersion=1
DevelopmentIdentity__Role=STAFF

# =============================================================================
# DEVOPS SYSTEM ALERTS & APPROVAL WORKFLOW (MVP)
# =============================================================================

# Direct Gmail SMTP Configuration
# [SECRET] Notification__Email__Password must be a 16-character Google App Password (stored in Azure Key Vault / local secret)
Notification__Email__Host=smtp.gmail.com
Notification__Email__Port=587
Notification__Email__UseStartTls=true
Notification__Email__SenderName=Aurora DevOps Monitor
Notification__Email__Username=aurora-devops-alerts@gmail.com
Notification__Email__Password=replace-with-16-char-gmail-app-password

# System Alert Email Recipients (Up to 4 accounts)
Notification__SystemAlerts__Emails__0=lead-sre@company.com
Notification__SystemAlerts__Emails__1=oncall-engineer@company.com
Notification__SystemAlerts__Emails__2=devops-team@company.com
Notification__SystemAlerts__Emails__3=platform-lead@company.com

# Telegram Bot API Configuration
# [SECRET] Notification__Telegram__BotToken and Notification__Telegram__WebhookSecret (stored in Azure Key Vault / local secret)
Notification__Telegram__BotToken=replace-with-telegram-bot-token
Notification__Telegram__WebhookSecret=replace-with-random-32-char-secret-token

# System Alert Telegram Destinations (Group Chat ID with negative integer or individual Chat IDs)
Notification__SystemAlerts__TelegramChatIds__0=-1001234567890
Notification__SystemAlerts__TelegramChatIds__1=
Notification__SystemAlerts__TelegramChatIds__2=
Notification__SystemAlerts__TelegramChatIds__3=
